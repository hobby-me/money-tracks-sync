# /opt/synk/synk.env — общие настройки сервера. Их читают systemd-юнит,
# консоль synk-tui и CLI, поэтому адрес в блоке подключения у кода
# приглашения не разойдётся с настоящим.

# Папка данных: accounts.db и по папке на учётку (sync.db + фото).
SYNK_DATA=/opt/synk/data

# API — только localhost, наружу его отдаёт nginx с TLS.
SYNK_LISTEN=127.0.0.1:8090

# Метрики — отдельный порт, nginx его не проксирует.
SYNK_METRICS_LISTEN=127.0.0.1:8091

# Публичный адрес — попадает в текст приглашения для нового устройства.
SYNK_PUBLIC_URL=https://sync.example.com

# Потолок хранилища на учётку по умолчанию (МБ); 0 — без лимита.
SYNK_ACCOUNT_QUOTA_MB=1024
